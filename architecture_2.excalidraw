    },
    {
      "id": "yEH14seEQz4Drp3SMW5Nm",
      "type": "text",
      "x": 1447.0191093085202,
      "y": 63.55842189962567,
      "width": 677.2317504882812,
      "height": 180,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
